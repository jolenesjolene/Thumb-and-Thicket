      },
      "when": {
        "facing": "south",
        "flowers": "2|3"
      }
    },
    {
      "apply": {
        "model": "modid:block/flowers/flower_type_1",
        "y": 270
      },
      "when": {
        "facing": "west",
        "flowers": "2|3"
      }
    },
    {
      "apply": {
        "model": "modid:block/flowers/flower_type_2"
      },
