{
  "multipart": [
    {
      "apply": {
        "model": "modid:block/flower_type"
      },
      "when": {
        "facing": "north|east|west|south",
        "flowers": "1"
      }
    },
    {
      "apply": {
        "model": "modid:block/flowers/flower_type_1"
      },
      "when": {
        "facing": "north",
        "flowers": "2|3"
      }
    },
    {
      "apply": {
        "model": "modid:block/flowers/flower_type_1",
